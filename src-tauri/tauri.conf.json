{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mission Builder",
  "version": "0.2.0",
  "identifier": "com.waspindustry.missionbuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mission Builder",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNkNFNjhBNDYzQjA2QkQKUldTOUJqdEdpdVpzVVFZVEFPWjc3M21IUkVlTlJrY01lUURocW1ac3ZySjdaanhCOFV3ZlRNUlAK",
      "endpoints": [
        "https://github.com/phuwanat-vg/mission-builder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
